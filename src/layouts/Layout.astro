---
import { ClientRouter } from "astro:transitions";
import PlayerBar from "../components/PlayerBar.astro";
import { localeOf } from "../i18n";
import { analytics } from "../data/analytics";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Adrián Furlan" } = Astro.props;

// The page's language, from its address: /en/… is English, the rest Spanish.
const locale = localeOf(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,700&family=Archivo:wght@400;700&family=Archivo+Narrow:wght@700&display=swap"
      rel="stylesheet"
    />
    {
      /* The owner's opt-out from the play counts: visiting any page with ?nocount writes the note Umami checks before sending anything, so that browser is never counted; ?count removes it. is:inline keeps the tag as written so it runs before the tracker below. */
    }
    <script is:inline>
      try {
        const query = new URLSearchParams(location.search);
        if (query.has("nocount")) localStorage.setItem("umami.disabled", "1");
        if (query.has("count")) localStorage.removeItem("umami.disabled");
      } catch {
        /* private window or blocked storage: nothing to remember */
      }
    </script>
    {
      /* Umami's tracker, only when a website ID is set. is:inline keeps the tag as written so the browser loads it straight from Umami. */
    }
    {
      analytics.websiteId && (
        <script
          is:inline
          defer
          src={analytics.script}
          data-website-id={analytics.websiteId}
        />
      )
    }
    <title>{title}</title>
    {
      /* Client-side navigation so the player bar (and its audio) survives page changes. Pages cross-fade with Astro\'s default. */
    }
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    <PlayerBar />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  /* The body grows with the page (global.css gives it a minimum of one
     screen) rather than being pinned to one screen, so the sticky header
     on phones has the whole page to stick to. */
  html {
    height: 100%;
  }
</style>

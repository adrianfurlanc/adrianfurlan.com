---
import { ClientRouter } from "astro:transitions";
import PlayerBar from "../components/PlayerBar.astro";
import { localeOf } from "../i18n";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Adrián Furlan" } = Astro.props;

// The page's language, from its address: /es/… is Spanish, the rest English.
const locale = localeOf(Astro);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,700&family=Archivo:wght@400;700&family=Archivo+Narrow:wght@700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {
      /* Client-side navigation so the player bar (and its audio) survives page changes. Pages cross-fade with Astro\'s default. */
    }
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
    <PlayerBar />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

---
import TrackRow from "./TrackRow.astro";
import type { Track } from "../data/tracks";
import { localeOf } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
  tracks: Track[];
  year: string;
  coverSrc: string;
  coverAlt: string;
  note: string;
  release: string;
}

const { tracks, year, coverSrc, coverAlt, note, release } = Astro.props;
const t = ui[localeOf(Astro)];
---

<section class="tracks" aria-labelledby="tracks-title">
  <div class="head">
    <h2 class="heading" id="tracks-title">{t.home.tracksHeading}</h2>
    <span class="label">{t.home.pressPlay}</span>
  </div>
  <div class="list">
    {
      tracks.map((track) => (
        <TrackRow
          num={track.num}
          slug={track.slug}
          title={track.title}
          duration={track.duration}
          year={year}
          coverSrc={coverSrc}
          coverAlt={coverAlt}
          release={release}
        />
      ))
    }
  </div>
  <p class="note">{note}</p>
</section>

<style>
  .tracks {
    margin-top: var(--space-xl);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--light-blue);
  }

  .heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--headline-sm-size);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--headline-sm-ls);
    color: var(--sounding-ink);
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  .note {
    margin: var(--space-md) 0 0;
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    font-weight: var(--weight-regular);
    line-height: var(--body-sm-lh);
    color: var(--chart-grey);
  }

  @media (width < 720px) {
    .tracks {
      margin-top: 36px;
    }

    .head {
      padding-bottom: 10px;
    }

    /* Same size as "The Timeless EP" above; see tokens.css. */
    .heading {
      font-size: var(--hero-title-size);
      line-height: 1.2;
    }

    /* Same size as the About page's grey credits on phones. */
    .note {
      margin-top: 14px;
      font-size: 18px;
    }
  }
</style>

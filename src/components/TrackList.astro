---
import TrackRow from "./TrackRow.astro";
import type { Track } from "../data/tracks";

interface Props {
  tracks: Track[];
  year: string;
  coverSrc: string;
  coverAlt: string;
  note: string;
}

const { tracks, year, coverSrc, coverAlt, note } = Astro.props;
---

<section class="tracks" aria-labelledby="tracks-title">
  <div class="head">
    <h2 class="heading" id="tracks-title">Tracks</h2>
    <span class="label">Press play</span>
  </div>
  <div class="list">
    {
      tracks.map((track) => (
        <TrackRow
          num={track.num}
          slug={track.slug}
          title={track.title}
          duration={track.duration}
          year={year}
          coverSrc={coverSrc}
          coverAlt={coverAlt}
        />
      ))
    }
  </div>
  <p class="note">{note}</p>
</section>

<script>
  // One small player for the whole list. Each row owns a hidden <audio>
  // element; this script presses play/pause on it, keeps only one track
  // playing at a time, and reads its clock to move the seek bar.
  const fmt = (seconds: number) => {
    const s = Math.max(0, Math.floor(seconds));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  };

  const rows = [...document.querySelectorAll<HTMLElement>("[data-track]")];
  let active: HTMLElement | null = null;

  const parts = (row: HTMLElement) => ({
    audio: row.querySelector("audio") as HTMLAudioElement,
    button: row.querySelector(".transport") as HTMLButtonElement,
    glyph: row.querySelector(".glyph") as HTMLElement,
    time: row.querySelector(".time") as HTMLElement,
    seek: row.querySelector(".seek") as HTMLElement,
  });

  const reset = (row: HTMLElement) => {
    const { button, glyph, time, seek } = parts(row);
    row.dataset.state = "off";
    glyph.textContent = glyph.dataset.num ?? "";
    time.textContent = row.dataset.duration ?? "";
    seek.hidden = true;
    seek.style.setProperty("--progress", "0%");
    seek.setAttribute("aria-valuenow", "0");
    button.setAttribute("aria-pressed", "false");
    button.setAttribute("aria-label", "Play");
    if (active === row) active = null;
  };

  const stop = (row: HTMLElement) => {
    const { audio } = parts(row);
    audio.pause();
    audio.currentTime = 0;
    reset(row);
  };

  const activate = (row: HTMLElement) => {
    if (active && active !== row) stop(active);
    active = row;
    // play() rejects when the file is missing; the row simply goes back to "off".
    parts(row)
      .audio.play()
      .catch(() => reset(row));
  };

  rows.forEach((row, index) => {
    const { audio, button, glyph, time, seek } = parts(row);

    button.addEventListener("click", () => {
      if (active !== row) {
        activate(row);
      } else if (audio.paused) {
        audio.play().catch(() => reset(row));
      } else {
        audio.pause();
      }
    });

    const showProgress = () => {
      time.textContent = fmt(audio.currentTime);
      const pct = audio.duration
        ? (audio.currentTime / audio.duration) * 100
        : 0;
      seek.style.setProperty("--progress", `${pct}%`);
      seek.setAttribute("aria-valuenow", String(Math.round(pct)));
    };

    audio.addEventListener("play", () => {
      row.dataset.state = "playing";
      glyph.textContent = "▶";
      button.setAttribute("aria-pressed", "true");
      button.setAttribute("aria-label", "Pause");
      seek.hidden = false;
      showProgress();
    });

    audio.addEventListener("pause", () => {
      if (active !== row) return;
      row.dataset.state = "paused";
      glyph.textContent = "‖";
      button.setAttribute("aria-pressed", "false");
      button.setAttribute("aria-label", "Play");
    });

    audio.addEventListener("timeupdate", () => {
      if (active === row) showProgress();
    });

    audio.addEventListener("ended", () => {
      stop(row);
      const next = rows[index + 1];
      if (next) activate(next);
    });

    audio.addEventListener("error", () => reset(row));

    const seekTo = (clientX: number) => {
      if (!Number.isFinite(audio.duration)) return;
      const rect = seek.getBoundingClientRect();
      const fraction = Math.min(
        1,
        Math.max(0, (clientX - rect.left) / rect.width),
      );
      audio.currentTime = fraction * audio.duration;
    };

    seek.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      seekTo(event.clientX);
      // Capture keeps the drag alive if the pointer leaves the bar; optional.
      try {
        seek.setPointerCapture(event.pointerId);
      } catch {
        /* not a live pointer; a plain click still seeks */
      }
    });

    seek.addEventListener("pointermove", (event) => {
      if (seek.hasPointerCapture(event.pointerId)) seekTo(event.clientX);
    });

    seek.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      if (!Number.isFinite(audio.duration)) return;
      const step = audio.duration * 0.05;
      const delta = event.key === "ArrowRight" ? step : -step;
      audio.currentTime = Math.min(
        audio.duration,
        Math.max(0, audio.currentTime + delta),
      );
    });
  });
</script>

<style>
  .tracks {
    margin-top: var(--space-xl);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--light-blue);
  }

  .heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--headline-sm-size);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--headline-sm-ls);
    color: var(--sounding-ink);
  }

  .label {
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  .note {
    margin: var(--space-md) 0 0;
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    font-weight: var(--weight-regular);
    line-height: var(--body-sm-lh);
    color: var(--chart-grey);
  }

  @media (width < 720px) {
    .tracks {
      margin-top: 36px;
    }

    .head {
      padding-bottom: 10px;
    }

    .heading {
      font-size: 24px;
      line-height: 1.2;
    }

    .note {
      margin-top: 14px;
    }
  }
</style>

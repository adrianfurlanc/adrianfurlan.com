---
import { localeOf, localePath, locales, pathWithoutLocale } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
  current?: "home" | "about" | "blog" | "contact";
}

const { current } = Astro.props;
const locale = localeOf(Astro);
const t = ui[locale];

const links = [
  { key: "home", label: t.nav.home, href: localePath(locale, "/") },
  { key: "about", label: t.nav.about, href: localePath(locale, "/about") },
  { key: "blog", label: t.nav.blog, href: localePath(locale, "/blog") },
  {
    key: "contact",
    label: t.nav.contact,
    href: localePath(locale, "/contact"),
  },
] as const;

// This page's address without its language, so the EN/ES toggle can link to
// the same page in the other language.
const here = pathWithoutLocale(Astro.url.pathname);
---

<header class="site-header">
  <div class="bar">
    <button
      class="menu-toggle"
      type="button"
      aria-label={t.header.menu}
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <svg
        width="22"
        height="16"
        viewBox="0 0 22 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M1 1.5h20M1 8h20M1 14.5h20"></path>
      </svg>
    </button>
    <a class="wordmark" href={localePath(locale, "/")}>{t.site.name}</a>
    <div class="right">
      <nav class="nav" id="primary-nav" aria-label={t.header.primary}>
        {
          links.map((link) => (
            <a
              class="nav-link"
              href={link.href}
              aria-current={link.key === current ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="lang" role="group" aria-label={t.header.language}>
        {
          locales.map((option) => (
            <a
              class="lang-option"
              href={localePath(option, here)}
              hreflang={option}
              lang={option}
              aria-current={option === locale ? "true" : undefined}
            >
              {option.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</header>

<script>
  // Runs on every page load, including client-side navigations, because
  // the header is rebuilt each time the page changes.
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.getElementById("primary-nav");

    if (toggle && nav) {
      toggle.addEventListener("click", () => {
        const open = nav.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(open));
      });
    }
  });
</script>

<style>
  .site-header {
    background: var(--sounding-ink);
  }

  .bar {
    max-width: 880px;
    margin: 0 auto;
    padding: 20px var(--page-margin);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gutter);
    flex-wrap: wrap;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--headline-sm-size);
    font-weight: var(--weight-bold);
    line-height: 1.1;
    letter-spacing: var(--headline-sm-ls);
    color: var(--sleeve);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--sleeve);
  }

  .right {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    font-feature-settings: "case" 1;
    text-decoration: none;
    color: var(--light-blue);
    transition: var(--transition-state);
  }

  .nav-link[aria-current="page"] {
    color: var(--sleeve);
  }

  .nav-link:hover {
    color: var(--celadon);
  }

  .lang {
    display: flex;
    align-items: center;
    border: 1px solid var(--light-blue);
    border-radius: var(--radius-control);
    overflow: hidden;
    margin-left: 28px;
  }

  .lang-option {
    display: flex;
    align-items: center;
    height: 26px;
    padding: 0 9px;
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: 1;
    letter-spacing: var(--label-caps-ls);
    text-decoration: none;
    color: var(--light-blue);
    background: transparent;
    cursor: pointer;
    transition: var(--transition-state);
  }

  .lang-option:hover {
    color: var(--light-blue);
  }

  .lang-option[aria-current="true"],
  .lang-option[aria-current="true"]:hover {
    color: var(--sounding-ink);
    background: var(--sleeve);
  }

  .menu-toggle {
    display: none;
  }

  /* Tablets: the nav links look the same, but an invisible layer around each
     one makes it about 44px tall, big enough for a finger. (On phones they are
     already full-width menu rows.) */
  @media (pointer: coarse) and (width >= 720px) {
    .nav-link {
      position: relative;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      inset: -14px -9px;
    }
  }

  /* Touch screens of any size: the same for the ES/EN toggle, which is small
     on phones and tablets alike. */
  @media (pointer: coarse) {
    .lang-option {
      position: relative;
    }

    .lang-option::after {
      content: "";
      position: absolute;
      inset: -9px 0;
    }

    /* Let the ES/EN tap layers reach outside the toggle's border; the active
       option keeps the rounded corners the clipping used to give it. */
    .lang {
      overflow: visible;
    }

    .lang-option:first-child {
      border-radius: 1px 0 0 1px;
    }

    .lang-option:last-child {
      border-radius: 0 1px 1px 0;
    }
  }

  @media (width < 720px) {
    /* Pinned to the top of the phone screen so the menu is always a tap
       away, however far down the page the reader has scrolled. */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .bar {
      padding: 14px 20px 16px;
      gap: 0 14px;
      align-items: center;
    }

    .right {
      display: contents;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-left: -10px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--sleeve);
      cursor: pointer;
      flex: none;
      order: 1;
    }

    .wordmark {
      display: flex;
      align-items: center;
      height: 44px;
      flex: 1;
      font-size: 24px;
      line-height: 1;
      order: 2;
    }

    .lang {
      margin-left: 0;
      order: 3;
    }

    .nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      margin-top: 14px;
      border-top: 1px solid var(--deep-water);
      order: 4;
    }

    .nav.is-open {
      display: flex;
    }

    .nav-link {
      display: flex;
      width: 100%;
      padding: 15px 0;
      border-bottom: 1px solid var(--deep-water);
      font-size: 15px;
      transition: none;
    }

    .nav-link:last-child {
      border-bottom: 0;
    }

    /* A tap counts as hover on phones: the link lights up at once, like the
       blog's page numbers, so the reader sees it registered. */
    .nav-link:hover,
    .nav-link:active {
      color: var(--sleeve);
    }
  }
</style>

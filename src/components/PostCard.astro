---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { localeOf } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
  title: string;
  href: string;
  date: string;
  dateTime: string;
  excerpt: string;
  caption: string;
  image?: ImageMetadata;
}

const { title, href, date, dateTime, excerpt, caption, image } = Astro.props;
const t = ui[localeOf(Astro)];
---

<article class="card">
  {
    image ? (
      <Image
        class="figure figure-photo"
        src={image}
        alt={caption}
        widths={[400, 800]}
        sizes="(width < 720px) calc(100vw - 40px), 400px"
        format="webp"
      />
    ) : (
      <div class="figure">
        <span class="caption">{caption}</span>
      </div>
    )
  }
  <time class="date" datetime={dateTime}>{date}</time>
  <h3 class="title"><a href={href}>{title}</a></h3>
  <p class="excerpt">{excerpt}</p>
  <div class="read">
    <a class="read-link" href={href}>
      {t.blog.read}<svg
        class="arrow"
        width="14"
        height="11"
        viewBox="0 0 14 11"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M0.5 5.5 H12"></path>
        <path d="M8.5 2 L12 5.5 L8.5 9"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-wash);
  }

  .figure {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 10;
    padding: 10px;
    border: 1px solid var(--light-blue);
    background: var(--foam);
  }

  .figure-photo {
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
    border: 0;
    object-fit: cover;
  }

  .caption {
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  .date {
    display: block;
    margin-top: 32px;
    font-family: var(--font-sans);
    font-size: var(--data-catalog-size);
    font-weight: var(--weight-bold);
    line-height: var(--data-catalog-lh);
    letter-spacing: var(--data-catalog-ls);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--chart-grey);
  }

  .title {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: var(--track-title-size);
    font-weight: var(--weight-bold);
    line-height: 1.25;
  }

  .title a {
    color: var(--sounding-ink);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .title a:hover {
    color: var(--title-hover);
  }

  .excerpt {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: var(--weight-regular);
    line-height: 1.55;
    color: var(--sounding-ink);
  }

  /* Pushed to the card's bottom so the link and its rule line up across a row of cards. */
  .read {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 20px;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--light-blue);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    font-feature-settings: "case" 1;
    color: var(--deep-water);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .read-link:hover {
    color: var(--title-hover);
  }

  .arrow {
    margin-left: 8px;
    flex: none;
  }

  @media (hover: hover) and (width >= 720px) {
    .card:hover {
      position: relative;
      z-index: 1;
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  @media (width < 720px) {
    .card {
      padding: 40px 0 37px;
      border-top: 1px solid var(--light-blue);
    }

    .figure {
      padding: 26px;
    }

    .figure-photo {
      padding: 0;
    }

    .date {
      padding: 4px 0;
    }

    .title {
      margin-top: 20px;
      padding: 4px 0;
      font-size: 24px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .excerpt {
      margin-top: 20px;
      padding: 4px 0;
      font-size: var(--body-md-size);
      line-height: var(--body-md-lh);
    }

    .read {
      margin-top: 20px;
      padding: 13px 0;
      border-bottom: 0;
    }
  }
</style>

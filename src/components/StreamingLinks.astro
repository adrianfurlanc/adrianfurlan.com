---
// "Listen on" section: one card per streaming platform, below the track
// list. Platforms with an empty address are skipped, and
// the whole section is left out when none has one. Each card's mark takes
// the platform's brand colour, passed in as --brand; the border rests in
// Deep Water and takes the brand colour on hover.
import PlatformIcon from "./PlatformIcon.astro";
import { brandColors } from "../data/platforms";
import type { StreamingPlatform } from "../data/tracks";
import { localeOf } from "../i18n";
import { ui } from "../i18n/ui";

interface Props {
  platforms: StreamingPlatform[];
}

const { platforms } = Astro.props;
const locale = localeOf(Astro);
const t = ui[locale];
const shown = platforms.filter((platform) => platform.href);
---

{
  shown.length > 0 && (
    <section class="listen" aria-labelledby="listen-title">
      <div class="head">
        <h2 class="heading" id="listen-title">
          {t.home.listenOn}
        </h2>
      </div>
      <div class="grid">
        {shown.map((platform) => (
          <a
            class="card"
            href={platform.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--brand: ${brandColors[platform.icon]}`}
          >
            <span class="mark">
              <PlatformIcon icon={platform.icon} />
            </span>
            <svg
              class="arrow"
              width="12"
              height="12"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M3.25 8.75 L8.75 3.25" />
              <path d="M4.75 3.25 H8.75 V7.25" />
            </svg>
            <span class="name">{platform.name}</span>
            {platform.note && <span class="note">{platform.note[locale]}</span>}
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .listen {
    margin-top: var(--space-xl);
  }

  /* Same head as the track list: serif heading over a hairline. */
  .head {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--light-blue);
  }

  .heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--headline-sm-size);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: var(--headline-sm-ls);
    color: var(--sounding-ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: var(--space-md);
  }

  /* One card per platform: mark top-left, arrow top-right, name (and an
     optional note) at the foot. */
  .card {
    display: grid;
    grid-template:
      "mark arrow" auto
      "name name" auto
      "note note" auto / 1fr auto;
    align-content: space-between;
    min-height: 128px;
    padding: 14px;
    border: 1px solid var(--deep-water);
    border-radius: var(--radius-structural);
    background: var(--sleeve);
    text-decoration: none;
    color: var(--sounding-ink);
    transition:
      background-color var(--transition-wash),
      border-color var(--transition-wash),
      transform var(--transition-wash);
  }

  .mark {
    grid-area: mark;
    display: block;
    line-height: 0;
    color: var(--brand, var(--deep-water));
  }

  .arrow {
    grid-area: arrow;
    color: var(--chart-grey);
    transition: color var(--transition-state);
  }

  .name {
    grid-area: name;
    margin-top: var(--space-lg);
    font-family: var(--font-serif);
    font-size: var(--body-md-size);
    font-weight: var(--weight-regular);
    line-height: var(--track-title-lh);
  }

  .note {
    grid-area: note;
    margin-top: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  @media (hover: hover) {
    .card:hover {
      background: var(--foam);
      border-color: var(--brand, var(--deep-water));
      transform: scale(1.02);
    }

    .card:hover .arrow {
      color: var(--deep-water);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }

  @media (width < 720px) {
    .listen {
      margin-top: 36px;
    }

    .head {
      padding-bottom: 10px;
    }

    .heading {
      font-size: 24px;
      line-height: 1.2;
    }

    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 12px;
    }

    .card {
      min-height: 112px;
      padding: 14px;
    }

    /* An odd fifth card takes the full row instead of sitting alone. */
    .card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .name {
      margin-top: var(--space-md);
      font-size: var(--body-lg-size);
    }
  }
</style>

---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { localeOf, localePath } from "../../i18n";
import { ui } from "../../i18n/ui";
import {
  byNewest,
  formatDate,
  isoDate,
  localisedPost,
  postHref,
} from "../../utils/blog";

// One page per post. Posts are sorted newest first so each page also
// knows its neighbours: "newer" is the next post, "older" the previous.
export async function getStaticPaths() {
  const sorted = (await getCollection("blog")).sort(byNewest);
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: sorted[i - 1], older: sorted[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  newer?: CollectionEntry<"blog">;
  older?: CollectionEntry<"blog">;
}

const { post, newer, older } = Astro.props;
const locale = localeOf(Astro);
const t = ui[locale];

// In Spanish, a twin file in src/content/blog-es/ (same filename) supplies the
// words and the body; dates and the order always come from the English posts.
const twins = new Map<string, CollectionEntry<"blogEs">>();
if (locale === "es") {
  for (const entry of await getCollection("blogEs")) twins.set(entry.id, entry);
}
const twin = twins.get(post.id);
const shown = localisedPost(post, twin);

// The Previous/Next links follow the same rule for their titles.
const olderTitle = older && localisedPost(older, twins.get(older.id)).title;
const newerTitle = newer && localisedPost(newer, twins.get(newer.id)).title;
const { Content } = twin ? await render(twin) : await render(post);

const body = (twin ?? post).body ?? "";
const words = body.trim().split(/\s+/).filter(Boolean).length;
const readTime = Math.max(1, Math.ceil(words / 200));
---

<Layout title={`${shown.title} · ${t.site.name}`}>
  <SiteHeader current="blog" />
  <main class="page">
    {!newer && <p class="label latest">{t.blog.latest}</p>}
    {
      shown.image ? (
        <Image
          class="figure figure-photo"
          src={shown.image}
          alt={shown.caption}
          widths={[720, 1440]}
          sizes="(width < 720px) calc(100vw - 40px), 800px"
          format="webp"
        />
      ) : (
        <div class="figure">
          <span class="caption">{shown.caption}</span>
        </div>
      )
    }
    <article class="post">
      <h1 class="title">{shown.title}</h1>
      <p class="meta">
        <span>{t.post.readTime(readTime)}</span>
        <span aria-hidden="true">·</span>
        <time class="posted" datetime={isoDate(post.data.date)}>
          {formatDate(post.data.date, locale)}
        </time>
      </p>
      {
        locale === "es" && !twin && (
          <p class="meta untranslated">{t.post.untranslated}</p>
        )
      }
      <div class="body post-body">
        <Content />
      </div>

      <nav class="neighbours" aria-label={t.post.neighbours}>
        {
          older ? (
            <a
              class="neighbour neighbour-link"
              href={postHref(older.id, locale)}
            >
              <span class="label">{t.post.previous}</span>
              <span class="neighbour-title">{olderTitle}</span>
              <time class="neighbour-date" datetime={isoDate(older.data.date)}>
                {formatDate(older.data.date, locale)}
              </time>
            </a>
          ) : (
            <div class="neighbour">
              <span class="label">{t.post.previous}</span>
              <p class="neighbour-note">{t.post.oldest}</p>
            </div>
          )
        }
        {
          newer ? (
            <a
              class="neighbour neighbour-link neighbour-next"
              href={postHref(newer.id, locale)}
            >
              <span class="label">{t.post.next}</span>
              <span class="neighbour-title">{newerTitle}</span>
              <time class="neighbour-date" datetime={isoDate(newer.data.date)}>
                {formatDate(newer.data.date, locale)}
              </time>
            </a>
          ) : (
            <div class="neighbour neighbour-next">
              <span class="label">{t.post.next}</span>
              <p class="neighbour-note">{t.post.newest}</p>
            </div>
          )
        }
      </nav>

      <div class="all-posts">
        <a class="all-posts-link" href={localePath(locale, "/blog")}>
          <svg
            class="arrow"
            width="14"
            height="11"
            viewBox="0 0 14 11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <path d="M13.5 5.5 H2"></path>
            <path d="M5.5 2 L2 5.5 L5.5 9"></path>
          </svg>
          {t.post.allPosts}
        </a>
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>

<script>
  // The HTML carries the absolute date; this turns it into "4 days ago"
  // in the browser so it never goes stale on a static page. Bound on every
  // page load because client-side navigation rebuilds the page.
  const relativeDate = () => {
    const posted = document.querySelector<HTMLTimeElement>(".posted");
    if (!posted || !posted.dateTime || posted.dataset.relative) return;
    posted.dataset.relative = "true";
    const then = Date.parse(`${posted.dateTime}T00:00:00Z`);
    const now = new Date();
    const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    const days = Math.max(0, Math.round((today - then) / 86_400_000));

    // The browser knows how to say "3 days ago" or "hace 3 días" in the
    // page's language. "auto" gives "today"/"yesterday" (hoy/ayer) for days;
    // "always" keeps "1 month ago" rather than "last month".
    const lang = document.documentElement.lang || "en";
    const named = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
    const counted = new Intl.RelativeTimeFormat(lang, { numeric: "always" });

    let label: string;
    if (days < 30) {
      label = named.format(0 - days, "day");
    } else if (days < 365) {
      label = counted.format(0 - Math.floor(days / 30), "month");
    } else {
      label = counted.format(0 - Math.floor(days / 365), "year");
    }

    posted.title = (posted.textContent ?? "").trim();
    posted.textContent = label;
  };

  document.addEventListener("astro:page-load", relativeDate);
</script>

<style>
  .page {
    max-width: 880px;
    margin: 0 auto 40px;
    padding: var(--space-lg) var(--page-margin) 0;
  }

  .figure {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    padding: 10px;
    border: 1px solid var(--light-blue);
    background: var(--foam);
    transition: transform var(--transition-wash);
  }

  /* A real photo fills the same box: same ratio, border, and hover as the placeholder. */
  .figure-photo {
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
    border: 0;
    object-fit: cover;
  }

  .caption,
  .label {
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  .latest {
    margin: 0 0 var(--space-md);
  }

  .post {
    max-width: calc(68ch + 80px);
    margin: 0 auto;
    padding-top: 36px;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: var(--weight-bold);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--sounding-ink);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    font-family: var(--font-sans);
    font-size: var(--body-sm-size);
    font-weight: var(--weight-regular);
    line-height: var(--label-caps-lh);
    font-variant-numeric: tabular-nums;
    color: var(--chart-grey);
  }

  /* Shown on the Spanish page of a post that has no Spanish twin yet. */
  .untranslated {
    margin-top: 8px;
  }

  .body {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--light-blue);
  }

  .neighbours {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter) var(--space-lg);
    margin-top: var(--space-lg);
    padding: 28px 0;
    border-top: 1px solid var(--light-blue);
  }

  .neighbour {
    display: block;
    color: var(--sounding-ink);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .neighbour-link:hover {
    color: var(--deep-water);
  }

  .neighbour-next {
    text-align: right;
  }

  .neighbour-title {
    display: block;
    margin-top: 10px;
    font-family: var(--font-serif);
    font-size: var(--track-title-size);
    font-weight: var(--weight-bold);
    line-height: 1.25;
  }

  .neighbour-date {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--data-catalog-size);
    font-weight: var(--weight-bold);
    line-height: var(--data-catalog-lh);
    letter-spacing: var(--data-catalog-ls);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--chart-grey);
  }

  .neighbour-note {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-size: var(--body-md-size);
    font-weight: var(--weight-regular);
    line-height: 1.5;
    color: var(--chart-grey);
  }

  .all-posts {
    border-top: 1px solid var(--light-blue);
  }

  .all-posts-link {
    display: inline-flex;
    align-items: center;
    padding: 13px 0;
    font-family: var(--font-sans-narrow);
    font-size: var(--body-sm-size);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--deep-water);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .all-posts-link:hover {
    color: var(--title-hover);
  }

  .arrow {
    margin-right: var(--space-sm);
    flex: none;
  }

  @media (hover: hover) and (width >= 720px) {
    .figure:hover {
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figure:hover {
      transform: none;
    }
  }

  @media (width < 720px) {
    .page {
      padding: 20px 20px 0;
    }

    .figure {
      aspect-ratio: 4 / 3;
    }

    .post {
      padding-top: var(--gutter);
    }

    .title {
      font-size: 30px;
      line-height: 1.15;
    }

    .meta {
      margin-top: 14px;
    }

    .body {
      margin-top: 22px;
      padding-top: 22px;
    }

    .neighbours {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--gutter);
      margin-top: var(--space-lg);
    }

    .neighbour-title,
    .neighbour-date,
    .neighbour-note {
      display: none;
    }

    /* Only the labels show on phones: dark when linked, faded when there is no post that way. */
    .neighbour-link .label {
      color: var(--sounding-ink);
    }

    .neighbour:not(.neighbour-link) .label {
      color: var(--light-blue);
    }

    .all-posts-link {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
</style>

<style is:global>
  /* Rendered Markdown lives outside the scoped styles, so these are global. */
  .post-body p {
    margin: 0 0 1.2em;
    font-family: var(--font-serif);
    font-size: var(--body-lg-size);
    font-weight: var(--weight-regular);
    line-height: var(--body-lg-lh);
    color: var(--sounding-ink);
    text-align: justify;
    hyphens: auto;
  }

  .post-body p:last-child {
    margin-bottom: 0;
  }

  /* Images written in the Markdown: fit the column, hard edges, hairline border. */
  .post-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.2em 0;
    border: 1px solid var(--light-blue);
  }

  @media (width < 720px) {
    .post-body p {
      font-size: var(--body-md-size);
      line-height: var(--body-md-lh);
    }
  }
</style>

---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PostCard from "../../components/PostCard.astro";
import { localeOf } from "../../i18n";
import { ui } from "../../i18n/ui";
import {
  blogPageHref,
  byNewest,
  formatDate,
  isoDate,
  localisedPost,
  postHref,
} from "../../utils/blog";

// Five posts per page, newest first. Astro's paginate() splits the list into
// pages: this one file makes /blog (page 1) and /blog/2, /blog/3, … after it.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("blog")).sort(byNewest);
  return paginate(posts, { pageSize: 5 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const locale = localeOf(Astro);
const t = ui[locale];

// In Spanish, a twin file in src/content/blog-es/ (same filename) supplies the
// words; the date and the order always come from the English post.
const twins = new Map<string, CollectionEntry<"blogEs">>();
if (locale === "es") {
  for (const twin of await getCollection("blogEs")) twins.set(twin.id, twin);
}
const shown = page.data.map((post) => ({
  id: post.id,
  date: post.data.date,
  ...localisedPost(post, twins.get(post.id)),
}));

// Page 1 shows its first post large; later pages are just the grid.
const first = page.currentPage === 1;
const featured = first ? shown[0] : undefined;
const grid = first ? shown.slice(1) : shown;
const pageOf = t.blog.pageOf(page.currentPage, page.lastPage);
const title = first
  ? `${t.blog.title} · ${t.site.name}`
  : `${t.blog.title} · ${pageOf} · ${t.site.name}`;

// The controls show up to five page numbers around the current one; phones
// show three of them (the rest get the class the phone styles hide). Spanish
// phones show only the current one, to leave room for the full "Anterior".
const clamp = (n: number, lo: number, hi: number) =>
  Math.min(Math.max(n, lo), hi);
const current = page.currentPage;
const last = page.lastPage;
const start = clamp(current - 2, 1, Math.max(1, last - 4));
const end = Math.min(last, start + 4);
const phoneCount = locale === "es" ? 1 : 3;
const phoneStart = clamp(
  current - (phoneCount === 3 ? 1 : 0),
  1,
  Math.max(1, last - (phoneCount - 1)),
);
const numbers = Array.from({ length: end - start + 1 }, (_, i) => start + i);
---

<Layout title={title}>
  <SiteHeader current="blog" />
  <main class="page">
    <div class="intro">
      <h1 class="title">{t.blog.title}</h1>
      <p class="lede">{t.blog.lede}</p>
    </div>
    {first && <hr class="rule" />}

    {
      featured && (
        <section class="featured" aria-labelledby="latest-title">
          <p class="label featured-label">{t.blog.latest}</p>
          {/* The figure opens the post too; the title link is the one for
              keyboards and screen readers, so this one is skipped by both. */}
          <a
            class="featured-link"
            href={postHref(featured.id, locale)}
            tabindex="-1"
            aria-hidden="true"
          >
            {featured.image ? (
              <Image
                class="featured-figure featured-photo"
                src={featured.image}
                alt={featured.caption}
                widths={[400, 800]}
                sizes="(width < 720px) calc(100vw - 40px), 400px"
                format="webp"
              />
            ) : (
              <div class="featured-figure">
                <span class="caption">{featured.caption}</span>
              </div>
            )}
          </a>
          <div class="featured-body">
            <h2 class="featured-title" id="latest-title">
              <a href={postHref(featured.id, locale)}>{featured.title}</a>
            </h2>
            <p class="featured-excerpt">{featured.excerpt}</p>
            <time class="date" datetime={isoDate(featured.date)}>
              {formatDate(featured.date, locale)}
            </time>
            <div class="featured-read">
              <a class="read-link" href={postHref(featured.id, locale)}>
                {t.blog.read}
                <svg
                  class="arrow"
                  width="14"
                  height="11"
                  viewBox="0 0 14 11"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="square"
                  aria-hidden="true"
                >
                  <path d="M0.5 5.5 H12" />
                  <path d="M8.5 2 L12 5.5 L8.5 9" />
                </svg>
              </a>
            </div>
          </div>
        </section>
      )
    }

    <div class:list={["earlier-head", { "page-head": !first }]}>
      <hr class="rule" />
      <p class="label">{first ? t.blog.earlier : pageOf}</p>
    </div>
    <div class="grid">
      {
        grid.map((post) => (
          <PostCard
            title={post.title}
            href={postHref(post.id, locale)}
            date={formatDate(post.date, locale)}
            dateTime={isoDate(post.date)}
            excerpt={post.excerpt}
            caption={post.caption}
            image={post.image}
          />
        ))
      }
    </div>

    {
      /* Only when there is more than one page. The arrows keep their <a> but lose the href on the first/last page. */
    }
    {
      last > 1 && (
        <nav class="pagination" aria-label={t.blog.pagination}>
          <a
            class="page-prev"
            href={current > 1 ? blogPageHref(current - 1, locale) : undefined}
            aria-disabled={current > 1 ? undefined : "true"}
          >
            <svg
              class="arrow"
              width="14"
              height="11"
              viewBox="0 0 14 11"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M13.5 5.5 H2" />
              <path d="M5.5 2 L2 5.5 L5.5 9" />
            </svg>
            <span>
              {t.blog.prev}
              <span class="prev-tail">{t.blog.prevTail}</span>
            </span>
          </a>
          <div class="pages">
            {numbers.map((n) =>
              n === current ? (
                <span class="page-num" aria-current="page">
                  {n}
                </span>
              ) : (
                <a
                  class:list={[
                    "page-num",
                    "page-link",
                    {
                      "page-num-wide":
                        n < phoneStart || n >= phoneStart + phoneCount,
                    },
                  ]}
                  href={blogPageHref(n, locale)}
                  aria-label={t.blog.pageNumber(n)}
                >
                  {n}
                </a>
              ),
            )}
          </div>
          <a
            class="page-next"
            href={
              current < last ? blogPageHref(current + 1, locale) : undefined
            }
            aria-disabled={current < last ? undefined : "true"}
          >
            {t.blog.next}
            <svg
              class="arrow"
              width="14"
              height="11"
              viewBox="0 0 14 11"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M0.5 5.5 H12" />
              <path d="M8.5 2 L12 5.5 L8.5 9" />
            </svg>
          </a>
        </nav>
      )
    }
  </main>
  <SiteFooter />
</Layout>

<style>
  .page {
    max-width: 880px;
    margin: 0 auto 56px;
    padding: 0 var(--page-margin);
  }

  .intro {
    padding-top: 56px;
  }

  .title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--headline-md-size);
    font-weight: var(--weight-bold);
    line-height: var(--headline-md-lh);
    letter-spacing: var(--headline-md-ls);
    color: var(--sounding-ink);
  }

  .lede {
    max-width: 34em;
    margin: var(--space-md) 0 0;
    font-family: var(--font-serif);
    font-size: var(--body-md-size);
    font-weight: var(--weight-regular);
    line-height: var(--body-md-lh);
    color: var(--sounding-ink);
  }

  .rule {
    height: var(--rule-weight);
    margin: 40px 0 0;
    border: 0;
    background: var(--light-blue);
  }

  .label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  /* Featured post: figure on the left, label + text on the right. */
  .featured {
    display: grid;
    grid-template: "figure label" auto "figure body" 1fr / 1fr 1fr;
    gap: 0 40px;
    align-items: start;
    margin-top: 40px;
    transition: transform var(--transition-wash);
  }

  .featured-label {
    grid-area: label;
  }

  .featured-link {
    grid-area: figure;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .featured-figure {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 4 / 3;
    padding: 10px;
    border: 1px solid var(--light-blue);
    background: var(--foam);
    transition: transform var(--transition-wash);
  }

  .featured-photo {
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
    border: 0;
    object-fit: cover;
  }

  .caption {
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    color: var(--chart-grey);
  }

  .featured-body {
    grid-area: body;
  }

  .featured-title {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: var(--weight-bold);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .featured-title a {
    color: var(--sounding-ink);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .featured-excerpt {
    margin: 28px 0 0;
    font-family: var(--font-serif);
    font-size: var(--body-md-size);
    font-weight: var(--weight-regular);
    line-height: var(--body-md-lh);
    color: var(--sounding-ink);
  }

  .date {
    display: block;
    margin-top: 28px;
    font-family: var(--font-sans);
    font-size: var(--data-catalog-size);
    font-weight: var(--weight-bold);
    line-height: var(--data-catalog-lh);
    letter-spacing: var(--data-catalog-ls);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--chart-grey);
  }

  .featured-read {
    margin-top: 20px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    font-feature-settings: "case" 1;
    color: var(--deep-water);
    text-decoration: none;
    transition: color var(--transition-state);
  }

  .arrow {
    margin-left: 8px;
    flex: none;
  }

  .earlier-head {
    margin-top: var(--space-xl);
  }

  /* On pages 2+ there is no featured post above, so this head's own rule
     stands in for the intro rule and sits at the same distance. */
  .page-head {
    margin-top: 0;
  }

  .earlier-head .label {
    margin-top: var(--gutter);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 40px;
    margin-top: var(--space-lg);
  }

  /* Pagination */
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-lg);
    margin-top: 56px;
    padding: 28px 0;
  }

  .page-prev,
  .page-next {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--label-caps-size);
    font-weight: var(--weight-bold);
    line-height: var(--label-caps-lh);
    letter-spacing: var(--label-caps-ls);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--deep-water);
    transition: color var(--transition-state);
  }

  .page-prev {
    justify-self: start;
  }

  .page-next {
    justify-self: end;
  }

  /* On the first or last page the arrow has nowhere to go: greyed, not clickable. */
  .page-prev[aria-disabled="true"],
  .page-next[aria-disabled="true"] {
    color: var(--light-blue);
    pointer-events: none;
  }

  .page-prev .arrow,
  .page-next .arrow {
    margin-left: 0;
  }

  .pages {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-variant-numeric: tabular-nums;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: var(--weight-bold);
    line-height: 1;
    color: var(--chart-grey);
    text-decoration: none;
    transition:
      color var(--transition-state),
      background var(--transition-state),
      border-color var(--transition-state),
      transform var(--transition-wash);
  }

  .page-num[aria-current="page"] {
    background: var(--primary);
    color: var(--sleeve);
  }

  .page-link:hover {
    border-color: var(--primary);
    color: var(--deep-water);
    transform: translateY(-5px);
  }

  @media (hover: hover) and (width >= 720px) {
    /* Phones skip the green: a tap would flash it before the page changes. */
    .featured-title a:hover,
    .read-link:hover,
    .page-prev:hover,
    .page-next:hover {
      color: var(--title-hover);
    }

    .featured:hover {
      position: relative;
      z-index: 1;
      transform: scale(1.02);
    }

    .featured-figure:hover {
      transform: scale(1.015);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured:hover,
    .featured-figure:hover {
      transform: none;
    }
  }

  /* Tablets: an invisible layer makes these links about 44px tall for a finger. */
  @media (pointer: coarse) and (width >= 720px) {
    .read-link,
    .page-prev,
    .page-next {
      position: relative;
    }

    .read-link::after,
    .page-prev::after,
    .page-next::after {
      content: "";
      position: absolute;
      inset: -14px -8px;
    }

    .page-prev::after,
    .page-next::after {
      inset: -15px -8px;
    }
  }

  @media (width < 720px) {
    .page {
      padding: 0 20px;
    }

    .intro {
      padding-top: 36px;
    }

    /* Page titles are 36px on phones, like "Sobre mí" on the About page. */
    .title {
      font-size: 36px;
      line-height: 1.2;
      letter-spacing: var(--headline-sm-ls);
    }

    /* Same reading size and line spacing as the About paragraphs on phones. */
    .lede {
      margin-top: 14px;
      font-size: 21px;
      line-height: var(--body-lg-lh);
    }

    .rule {
      margin-top: var(--space-lg);
    }

    .featured {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      margin-top: 20px;
    }

    .featured-figure {
      margin-top: var(--gutter);
      padding: 26px;
    }

    .featured-photo {
      padding: 0;
    }

    .featured-body {
      display: flex;
      flex-direction: column;
    }

    .featured-body .date {
      order: -1;
      margin-top: var(--space-md);
      padding: 4px 0;
    }

    .featured-title {
      margin-top: 20px;
      padding: 4px 0;
      font-size: 28px;
      line-height: 1.2;
    }

    /* Same reading size and line spacing as the About paragraphs on phones. */
    .featured-excerpt {
      margin-top: 20px;
      padding: 4px 0;
      font-size: 21px;
      line-height: var(--body-lg-lh);
    }

    .featured-read {
      display: flex;
      justify-content: flex-end;
      padding: 13px 0;
    }

    .read-link {
      font-size: 15px;
    }

    .earlier-head:not(.page-head) {
      display: none;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 40px;
    }

    .pagination {
      gap: 12px;
      margin-top: 0;
      padding: 40px 0 0;
      border-top: 1px solid var(--light-blue);
    }

    .page-prev,
    .page-next {
      min-height: var(--transport-size);
      font-size: 15px;
    }

    .prev-tail {
      display: none;
    }

    .page-num {
      width: var(--transport-size);
      height: var(--transport-size);
      font-size: 17px;
      transition: none;
    }

    /* A tap counts as hover on phones: no lift or border, the number just switches. */
    .page-link:hover {
      border-color: transparent;
      transform: none;
    }

    .page-num-wide {
      display: none;
    }
  }
</style>

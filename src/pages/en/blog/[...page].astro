---
// English blog list: the shared page rendered under /en/blog/. It reuses the
// shared page's list of pages, so /en/blog/2 exists whenever /blog/2 does.
import type { InferGetStaticPropsType } from "astro";
import Page, { getStaticPaths } from "../../blog/[...page].astro";

export { getStaticPaths };

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props: Props = Astro.props;
---

<Page {...props} />

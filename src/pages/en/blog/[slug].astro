---
// English post page: the shared page rendered under /en/blog/. It reuses the
// shared page's list of posts, so both languages have the same addresses.
import type { InferGetStaticPropsType } from "astro";
import Page, { getStaticPaths } from "../../blog/[slug].astro";

export { getStaticPaths };

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props: Props = Astro.props;
---

<Page {...props} />

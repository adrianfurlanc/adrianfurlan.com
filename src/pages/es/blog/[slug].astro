---
// Spanish post page: the English page rendered under /es/blog/. It reuses the
// English page's list of posts, so both languages have the same addresses.
import type { InferGetStaticPropsType } from "astro";
import Page, { getStaticPaths } from "../../blog/[slug].astro";

export { getStaticPaths };

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const props: Props = Astro.props;
---

<Page {...props} />

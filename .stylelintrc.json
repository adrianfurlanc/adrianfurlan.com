{
  "extends": "stylelint-config-standard",
  "rules": {
    "color-named": "never",
    "declaration-no-important": true,
    "selector-max-id": 0,
    "max-nesting-depth": 3,
    "no-unknown-animations": true
  },
  "overrides": [
    {
      "files": ["**/*.astro", "**/*.html"],
      "customSyntax": "postcss-html"
    }
  ]
}
